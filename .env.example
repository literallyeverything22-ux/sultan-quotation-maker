# Sultan Quotation Maker — Environment Secrets Template
# Copy this file to .env.local on your computer (or add these names in your web host's Environment Variables screen).
# NEVER put real secrets into this .env.example file or commit real secrets to Git.

# Server calls to Google Gemini AI for reading handwritten item photos
GEMINI_API_KEY=

# Which Gemini model to use (easy to swap in one place)
GEMINI_MODEL=gemini-2.5-flash

# Supabase database address (Project URL)
SUPABASE_URL=

# Server-only Supabase secret key (service_role key — never expose to browser)
SUPABASE_SERVICE_KEY=

# Staff PIN stored as a bcrypt hash (opens the app)
STAFF_PIN_HASH=

# Owner PIN stored as a bcrypt hash (unlocks Business Settings)
OWNER_PIN_HASH=

# Long random secret string used to sign the login session cookie
SESSION_SECRET=
